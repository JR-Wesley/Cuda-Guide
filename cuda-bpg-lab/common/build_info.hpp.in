#pragma once
#cmakedefine01 BPG_HAS_MAXNREG
namespace bpg {
inline constexpr const char* build_compiler = R"bpg(@CMAKE_CUDA_COMPILER_ID@ @CMAKE_CUDA_COMPILER_VERSION@; CXX tools @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@; CUDA host compiler=@CMAKE_CUDA_HOST_COMPILER@ (empty means nvcc default))bpg";
inline constexpr const char* build_arch = R"bpg(@CMAKE_CUDA_ARCHITECTURES@)bpg";
inline constexpr const char* build_flags = R"bpg(@BPG_NVCC_OPTIONS@; @CMAKE_CUDA_FLAGS@; @BPG_CONFIG_FLAGS@; C++17; configured @CMAKE_BUILD_TYPE@; see compile_commands.json for exact invocation)bpg";
}
